generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TEACHER
  PARENT
  STUDENT
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DISABLED
}

model User {
  id                 String        @id @default(cuid())
  name               String
  username           String        @unique
  email              String        @unique
  passwordHash       String
  role               UserRole      @default(STUDENT)
  status             AccountStatus @default(ACTIVE)
  failedLoginAttempts Int           @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([email])
  @@index([username])
  @@map("users")
}

model RolePermission {
  id String @id @default(cuid())
  title String
  data Json
  status String @default("Draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("role_permissions")
}

model StudentProgress {
  id String @id @default(cuid())
  title String
  data Json
  status String @default("Draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("student_progress")
}

model ParentStudentLink {
  id String @id @default(cuid())
  title String
  data Json
  status String @default("Draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("parent_student_links")
}

model TeacherAssignment {
  id String @id @default(cuid())
  title String
  data Json
  status String @default("Draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("teacher_assignments")
}

model Subject {
  id String @id @default(cuid())
  title String
  data Json
  status String @default("Draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("subjects")
}

model Chapter {
  id String @id @default(cuid())
  title String
  data Json
  status String @default("Draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("chapters")
}

model Lesson {
  id String @id @default(cuid())
  title String
  data Json
  status String @default("Draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("lessons")
}

model LearningMaterial {
  id String @id @default(cuid())
  title String
  data Json
  status String @default("Draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("learning_materials")
}

model Quiz {
  id String @id @default(cuid())
  title String
  data Json
  status String @default("Draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  questions AssessmentQuestion[]
  @@map("quizzes")
}

model AssessmentQuestion {
  id String @id @default(cuid())
  quizId String
  type String
  prompt String
  options Json
  correctAnswer Json
  points Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  @@index([quizId])
  @@map("assessment_questions")
}

model Exam {
  id String @id @default(cuid())
  title String
  data Json
  status String @default("Draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("exams")
}

model Assignment {
  id String @id @default(cuid())
  title String
  data Json
  status String @default("Draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("assignments")
}

model TeacherReport {
  id String @id @default(cuid())
  title String
  data Json
  status String @default("Draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("teacher_reports")
}

model CourseReport {
  id String @id @default(cuid())
  title String
  data Json
  status String @default("Draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("course_reports")
}

model PerformanceAnalytic {
  id String @id @default(cuid())
  title String
  data Json
  status String @default("Draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("performance_analytics")
}

model Guardian {
  id String @id @default(cuid())
  name String
  email String? @unique
  phone String?
  address String?
  occupation String?
  nationalId String?
  photoName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  studentLinks StudentGuardian[]
  @@map("guardians")
}

model Student {
  id String @id @default(cuid())
  fullName String
  dateOfBirth DateTime
  gender String
  admissionNumber String @unique
  photoName String?
  academicYear String
  gradeLevel String
  classSection String
  enrollmentDate DateTime
  address String?
  status String @default("Pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  guardianLinks StudentGuardian[]
  @@index([fullName])
  @@index([academicYear, gradeLevel, classSection])
  @@map("students")
}

model StudentGuardian {
  studentId String
  guardianId String
  relationshipType String @default("Guardian")
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  @@id([studentId, guardianId])
  @@map("student_guardians")
}

model GradeLevel {
  id String @id @default(cuid())
  name String
  classes Int @default(0)
  students Int @default(0)
  status String @default("Draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  classSections ClassSection[]
  @@map("grade_levels")
}

model ClassSection {
  id String @id @default(cuid())
  name String
  gradeLevelId String?
  students Int @default(0)
  status String @default("Draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  gradeLevel GradeLevel? @relation(fields: [gradeLevelId], references: [id], onDelete: SetNull)
  @@index([gradeLevelId])
  @@map("class_sections")
}

model Teacher {
  id String @id @default(cuid())
  fullName String
  gender String
  photoName String?
  phoneNumber String?
  address String?
  nationalId String?
  assignedSubjects String?
  assignedClasses String?
  status String @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("teachers")
}
